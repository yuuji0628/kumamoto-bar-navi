{
  "name": "kumamoto-bar-navi",
  "main": "worker.js",
  "compatibility_date": "2026-08-13",
  "keep_vars": true,
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "5f2c9effa39dd7b9001b18cf64d65836",
    "CLOUDFLARE_WORKER_NAME": "kumamoto-bar-navi",
    "KBN_CONFIG_VERSION": "4.84",
    "KBN_FULL_MAINTENANCE_CRONS": "0 3 * * *",
    "KBN_FULL_MAINTENANCE_TIME_JST": "12:00",
    "KBN_AUTO_ONLY_CRONS": "0 18 * * *|0 23 * * *|0 7 * * *|0 10 * * *|29 14 * * *",
    "KBN_AUTO_LISTING_TIMES_JST": "03:00|08:00|12:00|16:00|19:00|23:29",
    "KBN_SCHEDULE_UPDATED_AT": "2026-08-24T00:22:00+09:00"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/area/*",
      "/genre/*",
      "/about.html",
      "/kumamoto-bar.html",
      "/kumamoto-bar",
      "/shimotori-bar.html",
      "/shimotori-bar",
      "/karaoke-bar-kumamoto.html",
      "/karaoke-bar-kumamoto",
      "/darts-bar-kumamoto.html",
      "/darts-bar-kumamoto",
      "/snack-kumamoto.html",
      "/snack-kumamoto",
      "/kumamoto-station-bar.html",
      "/kumamoto-station-bar",
      "/suizenji-bar.html",
      "/suizenji-bar",
      "/kengun-bar.html",
      "/kengun-bar",
      "/hikarinomori-bar.html",
      "/hikarinomori-bar",
      "/yatsushiro-bar.html",
      "/yatsushiro-bar",
      "/hitoyoshi-bar.html",
      "/hitoyoshi-bar",
      "/tamana-bar.html",
      "/tamana-bar",
      "/amakusa-bar.html",
      "/amakusa-bar",
      "/area-amakusa.html",
      "/area-amakusa",
      "/area-aso.html",
      "/area-aso",
      "/area-hitoyoshi.html",
      "/area-hitoyoshi",
      "/area-kumamoto.html",
      "/area-kumamoto",
      "/area-yatsushiro.html",
      "/area-yatsushiro",
      "/index.html",
      "/index"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kumamoto-bar-navi-db",
      "database_id": "5f6aeb29-8868-4595-9b57-ac4fe9f2e108"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "kumamoto-bar-navi-images"
    }
  ],
  "triggers": {"crons": ["* * * * *"]}
}
